import torch
import torch.nn as nn
import torch.nn.functional as F
from typing import Dict, Optional
import math
import random


# Timestep Embedding

class TimestepEmbedding(nn.Module):
    def __init__(self, dim: int):
        super().__init__()
        self.dim = dim

    def forward(self, timesteps: torch.Tensor) -> torch.Tensor:
        half_dim = self.dim // 2
        scale = math.log(10000) / (half_dim - 1)
        emb = torch.exp(
            torch.arange(half_dim, device=timesteps.device) * -scale
        )
        emb = timesteps[:, None] * emb[None, :]
        emb = torch.cat([torch.sin(emb), torch.cos(emb)], dim=-1)
        return emb


# Temporal-Aware Encoder 
class TemporalAwareEncoder(nn.Module):
    def __init__(
        self,
        input_dim: int,
        latent_dim: int,
        timestep_dim: int = 256,
        use_timestep_conditioning: bool = True,
    ):
        super().__init__()
        self.use_timestep_conditioning = use_timestep_conditioning

        if use_timestep_conditioning:
            self.timestep_embed = TimestepEmbedding(timestep_dim)
            self.timestep_proj = nn.Sequential(
                nn.Linear(timestep_dim, timestep_dim),
                nn.SiLU(),
                nn.Linear(timestep_dim, latent_dim * 2),
            )

        self.encoder = nn.Linear(input_dim, latent_dim)
        nn.init.zeros_(self.encoder.bias)

    def forward(
        self,
        x: torch.Tensor,
        sigma: Optional[torch.Tensor] = None,
    ) -> torch.Tensor:
        z = self.encoder(x)  # pre-sparsity latent

        if self.use_timestep_conditioning and sigma is not None:
            t_emb = self.timestep_embed(sigma)
            scale, shift = self.timestep_proj(t_emb).chunk(2, dim=-1)
            # Proper broadcasting for [B, N, D] shaped z
            if z.dim() == 3:  # [B, N, D]
                z = z * (1 + scale.unsqueeze(1)) + shift.unsqueeze(1)
            else:  # [B, D]
                z = z * (1 + scale) + shift

        return z  # pre-activation


# Decoder with optional weight normalization

class TemporalAwareDecoder(nn.Module):
    def __init__(
        self, 
        latent_dim: int, 
        output_dim: int, 
        data_mean: Optional[torch.Tensor] = None,
        normalize_weights: bool = True,
    ):
        super().__init__()
        self.decoder = nn.Linear(latent_dim, output_dim)
        self.normalize_weights = normalize_weights
        
        # Initialize bias to data mean if provided, otherwise zero
        if data_mean is not None:
            self.decoder.bias.data.copy_(data_mean)
        else:
            nn.init.zeros_(self.decoder.bias)

    def forward(self, z: torch.Tensor) -> torch.Tensor:
        # Optional: normalize decoder weights to have unit norm columns
        # This is common in SAE literature to prevent scale collapse
        if self.normalize_weights and self.training:
            with torch.no_grad():
                self.decoder.weight.data = F.normalize(
                    self.decoder.weight.data, dim=1
                )
        
        return self.decoder(z)


# Universal Sparse Autoencoder

class UniversalSparseAutoencoder(nn.Module):
    def __init__(
        self,
        model_dims: Dict[str, int],
        latent_dim: int = 16384,
        timestep_dim: int = 256,
        use_timestep_conditioning: bool = True,
        top_k: Optional[int] = None,
        use_soft_topk: bool = True,
        topk_temperature: float = 0.1,
        data_means: Optional[Dict[str, torch.Tensor]] = None,
        normalize_decoder_weights: bool = True,
    ):
        """
        Args:
            model_dims: Dict mapping model names to their feature dimensions
            latent_dim: Dimension of shared sparse latent space
            timestep_dim: Dimension of timestep embeddings
            use_timestep_conditioning: Whether to use temporal conditioning
            top_k: Number of top features to keep (None for no top-k)
            use_soft_topk: Use soft (differentiable) top-k instead of hard masking
            topk_temperature: Temperature for soft top-k (lower = sharper)
            data_means: Optional dict of mean activations per model for decoder init
            normalize_decoder_weights: Whether to normalize decoder weights (unit norm)
        """
        super().__init__()
        self.model_names = list(model_dims.keys())
        self.model_dims = model_dims
        self.latent_dim = latent_dim
        self.top_k = top_k
        self.use_soft_topk = use_soft_topk
        self.topk_temperature = topk_temperature

        self.encoders = nn.ModuleDict()
        self.decoders = nn.ModuleDict()

        for name, dim in model_dims.items():
            self.encoders[name] = TemporalAwareEncoder(
                dim,
                latent_dim,
                timestep_dim,
                use_timestep_conditioning,
            )
            
            data_mean = data_means.get(name) if data_means else None
            self.decoders[name] = TemporalAwareDecoder(
                latent_dim,
                dim,
                data_mean=data_mean,
                normalize_weights=normalize_decoder_weights,
            )

    def apply_topk(self, z: torch.Tensor) -> torch.Tensor:
        """
        Apply top-k sparsity (soft or hard).
        
        Note: Hard top-k uses straight-through estimator for gradients.
        """
        if self.top_k is None:
            return z
        
        if self.use_soft_topk:
            # Soft top-k using temperature-based thresholding
            k_index = z.shape[-1] - self.top_k
            threshold = torch.kthvalue(z, k_index + 1, dim=-1, keepdim=True).values
            
            # Apply soft mask using sigmoid
            soft_mask = torch.sigmoid((z - threshold) / self.topk_temperature)
            return z * soft_mask
        else:
            # Hard top-k with straight-through estimator
            # Forward: hard mask, Backward: gradients flow through
            mask = torch.zeros_like(z)
            _, idx = torch.topk(z, self.top_k, dim=-1)
            mask.scatter_(-1, idx, 1.0)
            
            # Straight-through: use mask in forward, but let gradients pass
            return z * mask + (z * mask - z).detach()

    def encode(self, x, model_name, sigma):
        """
        Encode input to sparse latent representation.
        
        Returns:
            z_pre: Pre-activation latent (for temporal consistency)
            z_sparse: Sparse activated latent (for reconstruction)
        """
        # Pre-activation latent
        z_pre = self.encoders[model_name](x, sigma)

        # Apply ReLU activation
        z_activated = F.relu(z_pre)

        # Apply top-k sparsity if enabled
        z_sparse = self.apply_topk(z_activated)

        return z_pre, z_sparse

    def decode(self, z, model_name):
        return self.decoders[model_name](z)

    def forward(self, activations_dict, sigma, source_model):
        """
        Forward pass for Universal SAE.
        
        Args:
            activations_dict: Dict of activations for all models
            sigma: Timestep/noise level
            source_model: Which model's encoder to use
            
        Returns:
            recon: Dict of reconstructions for all models
            z_sparse: Sparse latent code (post-activation, post-top-k)
            z_pre: Pre-activation latent (for temporal loss)
        """
        z_pre, z_sparse = self.encode(
            activations_dict[source_model],
            source_model,
            sigma,
        )

        recon = {
            name: self.decode(z_sparse, name)
            for name in self.model_names
        }

        return recon, z_sparse, z_pre


# Trainer

class TemporalUniversalSAETrainer:
    def __init__(
        self,
        model: UniversalSparseAutoencoder,
        learning_rate: float = 1e-4,
        l1_coeff: float = 1e-3,
        temporal_coeff: float = 1e-2,
        max_grad_norm: float = 1.0,
        temporal_gradient_steps: int = 1,
        device: str = "cuda",
        use_scheduler: bool = True,
        temporal_on_sparse: bool = True,
    ):
        """
        Args:
            model: The Universal SAE model
            learning_rate: Base learning rate
            l1_coeff: Coefficient for L1 sparsity loss
            temporal_coeff: Coefficient for temporal consistency loss
            max_grad_norm: Maximum gradient norm for clipping
            temporal_gradient_steps: How many timesteps to backprop through
                                    (1 = detach each step, -1 = full BPTT)
            device: Device to train on
            use_scheduler: Whether to use learning rate scheduler
            temporal_on_sparse: If True, apply temporal loss to sparse codes (z_sparse)
                              If False, apply to pre-activation (z_pre)
        """
        self.model = model.to(device)
        self.device = device
        self.l1_coeff = l1_coeff
        self.temporal_coeff = temporal_coeff
        self.max_grad_norm = max_grad_norm
        self.temporal_gradient_steps = temporal_gradient_steps
        self.temporal_on_sparse = temporal_on_sparse

        # Optimizer: Train ALL encoders + decoders jointly
        self.optimizer = torch.optim.Adam(
            self.model.parameters(), lr=learning_rate
        )
        
        # Optional learning rate scheduler
        self.scheduler = None
        if use_scheduler:
            self.scheduler = torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(
                self.optimizer, T_0=1000, T_mult=2
            )

    def train_step(self, activations_dict, metadata):
        """
        Train step for Universal SAE with temporal consistency.
        
        FIXES:
        1. Sparsity loss now applied to z_sparse (actual sparse code)
        2. Temporal loss can be applied to either sparse or pre-activation
        3. Better gradient flow handling
        4. Improved metrics tracking
        """
        source_model = random.choice(self.model.model_names)
        
        # Move to device
        activations_dict = {
            k: v.to(self.device) for k, v in activations_dict.items()
        }
        sigmas = metadata['sigmas'].to(self.device)  # [B, T]
        
        B, T, N, D = activations_dict[source_model].shape
        
        total_recon_loss = 0.0
        total_sparsity_loss = 0.0
        temporal_losses = []
        
        z_prev = None  # Track previous timestep
        z_history = []  # For limited BPTT
        
        # Process each timestep
        for t in range(T):
            # Extract activations at timestep t
            acts_t = {k: v[:, t] for k, v in activations_dict.items()}  # [B, N, D]
            sigma_t = sigmas[:, t]  # [B]
            
            # Forward pass
            recon_t, z_sparse_t, z_pre_t = self.model(
                acts_t, sigma_t, source_model
            )
            
            # Reconstruction loss (all models)
            recon_loss_t = sum(
                F.mse_loss(recon_t[name], acts_t[name])
                for name in self.model.model_names
            )
            total_recon_loss += recon_loss_t
            
            # FIX: Sparsity loss on ACTUAL sparse activations
            # This is the critical fix - penalize what's actually being used
            sparsity_loss_t = z_sparse_t.abs().mean()
            total_sparsity_loss += sparsity_loss_t
            
            # Temporal consistency loss
            if z_prev is not None:
                # Choose which representation to enforce consistency on
                if self.temporal_on_sparse:
                    # Consistency on sparse codes (what's actually used)
                    z_curr = z_sparse_t
                else:
                    # Consistency on pre-activation (smoother optimization)
                    z_curr = z_pre_t
                
                # Apply gradient flow policy
                if self.temporal_gradient_steps == -1:
                    # Full BPTT - keep gradients
                    z_prev_use = z_prev
                elif self.temporal_gradient_steps > 1:
                    # Limited BPTT
                    steps_back = min(len(z_history), self.temporal_gradient_steps - 1)
                    z_prev_use = z_prev if steps_back > 0 else z_prev.detach()
                else:
                    # No temporal gradients - detach
                    z_prev_use = z_prev.detach()
                
                temporal_loss_t = F.mse_loss(z_prev_use, z_curr)
                temporal_losses.append(temporal_loss_t)
            
            # Store for next iteration
            if self.temporal_on_sparse:
                z_prev = z_sparse_t
                z_history.append(z_sparse_t)
            else:
                z_prev = z_pre_t
                z_history.append(z_pre_t)
            
            # Limit history length to save memory
            if self.temporal_gradient_steps > 0 and len(z_history) > self.temporal_gradient_steps:
                z_history.pop(0)
        
        # Average losses over time
        recon_loss = total_recon_loss / T
        sparsity_loss = (self.l1_coeff * total_sparsity_loss) / T
        
        if temporal_losses:
            temporal_loss = torch.stack(temporal_losses).mean()
        else:
            temporal_loss = torch.tensor(0.0, device=self.device)
        
        # Total loss
        total_loss = recon_loss + sparsity_loss + self.temporal_coeff * temporal_loss
        
        # Backward pass
        self.optimizer.zero_grad()
        total_loss.backward()
        
        # Gradient clipping
        grad_norm = torch.nn.utils.clip_grad_norm_(
            self.model.parameters(), 
            self.max_grad_norm
        )
        
        self.optimizer.step()
        
        # Update learning rate scheduler
        if self.scheduler is not None:
            self.scheduler.step()
        
        # Compute activation statistics
        with torch.no_grad():
            # Get final sparse code for statistics
            _, z_sparse_final = self.model.encode(
                activations_dict[source_model][:, -1],
                source_model,
                sigmas[:, -1]
            )
            
            # L0 norm (number of active features)
            active_features = (z_sparse_final > 1e-6).float()  # Small threshold for numerical stability
            l0_norm = active_features.sum(dim=-1).mean().item()
            
            # Fraction of features active
            sparsity_ratio = active_features.mean().item()
            
            # Dead features: features that are never active in this batch
            dead_features = (active_features.sum(dim=[0, 1]) == 0).sum().item()
            
            # Average activation magnitude (for active features)
            active_mask = z_sparse_final > 1e-6
            if active_mask.any():
                avg_activation = (z_sparse_final * active_mask).sum() / active_mask.sum()
            else:
                avg_activation = 0.0
        
        # Metrics
        metrics = {
            "total": total_loss.item(),
            "reconstruction": recon_loss.item(),
            "sparsity": sparsity_loss.item(),
            "temporal": temporal_loss.item(),
            "grad_norm": grad_norm.item(),
            "source_model": source_model,
            "l0_norm": l0_norm,
            "sparsity_ratio": sparsity_ratio,
            "dead_features": dead_features,
            "avg_activation": avg_activation.item() if torch.is_tensor(avg_activation) else avg_activation,
            "lr": self.optimizer.param_groups[0]['lr'],
        }
        
        return metrics

    @torch.no_grad()
    def validate(self, val_loader, num_batches: Optional[int] = None):
        """
        Validation loop with fixed metric averaging.
        
        FIX: Properly count batches (not models * batches)
        
        Args:
            val_loader: Validation data loader
            num_batches: Number of batches to validate on (None = all)
        
        Returns:
            Dict of averaged validation metrics
        """
        self.model.eval()
        
        total_metrics = {
            "reconstruction": 0.0,
            "sparsity": 0.0,
            "temporal": 0.0,
            "l0_norm": 0.0,
            "sparsity_ratio": 0.0,
        }
        
        # Track per-model metrics separately
        per_model_metrics = {
            model_name: {
                "reconstruction": 0.0,
                "sparsity": 0.0,
            }
            for model_name in self.model.model_names
        }
        
        num_batches_processed = 0
        
        for i, (activations_dict, metadata) in enumerate(val_loader):
            if num_batches is not None and i >= num_batches:
                break
            
            # Move to device
            activations_dict = {
                k: v.to(self.device) for k, v in activations_dict.items()
            }
            sigmas = metadata['sigmas'].to(self.device)
            
            B, T, N, D = activations_dict[self.model.model_names[0]].shape
            
            # Evaluate on all models as source
            for source_model in self.model.model_names:
                batch_recon = 0.0
                batch_sparsity = 0.0
                batch_temporal = []
                batch_l0 = 0.0
                batch_sparsity_ratio = 0.0
                
                z_prev = None
                
                for t in range(T):
                    acts_t = {k: v[:, t] for k, v in activations_dict.items()}
                    sigma_t = sigmas[:, t]
                    
                    recon_t, z_sparse_t, z_pre_t = self.model(
                        acts_t, sigma_t, source_model
                    )
                    
                    # Reconstruction loss
                    recon_loss_t = sum(
                        F.mse_loss(recon_t[name], acts_t[name])
                        for name in self.model.model_names
                    )
                    batch_recon += recon_loss_t.item()
                    
                    # FIX: Sparsity on actual sparse code
                    batch_sparsity += z_sparse_t.abs().mean().item()
                    
                    # L0 and sparsity ratio
                    active = (z_sparse_t > 1e-6).float()
                    batch_l0 += active.sum(dim=-1).mean().item()
                    batch_sparsity_ratio += active.mean().item()
                    
                    # Temporal consistency
                    if z_prev is not None:
                        z_curr = z_sparse_t if self.temporal_on_sparse else z_pre_t
                        batch_temporal.append(
                            F.mse_loss(z_prev, z_curr).item()
                        )
                    
                    z_prev = z_sparse_t if self.temporal_on_sparse else z_pre_t
                
                # Average over timesteps
                per_model_metrics[source_model]["reconstruction"] += batch_recon / T
                per_model_metrics[source_model]["sparsity"] += batch_sparsity / T
                
                total_metrics["reconstruction"] += batch_recon / T
                total_metrics["sparsity"] += batch_sparsity / T
                total_metrics["l0_norm"] += batch_l0 / T
                total_metrics["sparsity_ratio"] += batch_sparsity_ratio / T
                
                if batch_temporal:
                    total_metrics["temporal"] += sum(batch_temporal) / len(batch_temporal)
            
            num_batches_processed += 1
        
        # FIX: Average across batches AND models
        num_total_evals = num_batches_processed * len(self.model.model_names)
        for key in total_metrics:
            total_metrics[key] /= max(num_total_evals, 1)
        
        # Average per-model metrics
        for model_name in per_model_metrics:
            for key in per_model_metrics[model_name]:
                per_model_metrics[model_name][key] /= max(num_batches_processed, 1)
        
        total_metrics["per_model"] = per_model_metrics
        
        self.model.train()
        
        return total_metrics

    def save_checkpoint(self, path: str, epoch: int, metrics: dict):
        """Save training checkpoint"""
        checkpoint = {
            'epoch': epoch,
            'model_state_dict': self.model.state_dict(),
            'optimizer_state_dict': self.optimizer.state_dict(),
            'metrics': metrics,
            'config': {
                'l1_coeff': self.l1_coeff,
                'temporal_coeff': self.temporal_coeff,
                'temporal_on_sparse': self.temporal_on_sparse,
            }
        }
        if self.scheduler is not None:
            checkpoint['scheduler_state_dict'] = self.scheduler.state_dict()
        
        torch.save(checkpoint, path)
    
    def load_checkpoint(self, path: str):
        """Load training checkpoint"""
        checkpoint = torch.load(path, map_location=self.device)
        self.model.load_state_dict(checkpoint['model_state_dict'])
        self.optimizer.load_state_dict(checkpoint['optimizer_state_dict'])
        if self.scheduler is not None and 'scheduler_state_dict' in checkpoint:
            self.scheduler.load_state_dict(checkpoint['scheduler_state_dict'])
        
        return checkpoint['epoch'], checkpoint.get('metrics', {})
